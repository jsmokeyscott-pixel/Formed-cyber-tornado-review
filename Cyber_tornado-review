 const td=dTime();
 // never land within 1s of the answer signs, so you never have to pick between dodging and answering
 if(phase==='incoming'&&(1-cur.p)*travelTime()<td+1.1)return false;
 const diff=+$('difficulty').value,me=clamp(Math.round(laneTarget),-1,1);
 const L1=Math.random()<.5?me:[-1,0,1][Math.floor(Math.random()*3)];
 const lanes=[L1];
 if(diff>=6&&Math.random()<.25){const o=[-1,0,1].filter(x=>x!==L1);lanes.push(o[Math.floor(Math.random()*2)])}
 for(const L of lanes)debris.push({L,p:0,type:pickType(),rot:rnd(0,7),vr:rnd(-5,5)||3,arc:rnd(.15,.3),td});
 return true;
}
