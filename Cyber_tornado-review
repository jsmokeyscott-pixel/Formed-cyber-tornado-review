const DEBRIS=[{k:'cow',name:'COW',dmg:8,w:3},{k:'tire',name:'TIRE',dmg:5,w:2},{k:'plank',name:'BOARD',dmg:5,w:2},{k:'roof',name:'ROOF TIN',dmg:5,w:1.5},{k:'mail',name:'MAILBOX',dmg:5,w:1.5}];
