 if($('debrisOn').checked){debrisClock-=dt;if(debrisClock<=0){const diff=+$('difficulty').value;debrisClock=spawnDebris()?rnd(2.4,4.2)-diff*.13:.4}}
 const danger=[false,false,false];
 for(let i=debris.length-1;i>=0;i--){const d=debris[i];d.p+=dt/d.td;d.rot+=d.vr*dt;
  if(d.p>.45)danger[d.L+1]=true;
  if(d.p>=1){debris.splice(i,1);const pos=debrisPos(d.L,1,d),lane=clamp(Math.round(carX),-1,1);
   if(lane===d.L){health=Math.max(0,health-d.type.dmg);shake=RM?0:12;flash=.15;streak=0;
    cracks.push({x:pos.x,y:pos.y,r:rnd(26,40),age:0,color:'#ff9f43',name:d.type.name});
    pops.push({x:pos.x,y:pos.y-40,t:(d.type.k==='cow'?'MOO! ':'')+'−'+d.type.dmg+' HP',c:'#ff9f43',life:1.3});
    log(`DEBRIS: hit by ${d.type.name.toLowerCase()} (−${d.type.dmg} HP)`);updateHUD();
    if(health<=0){startCrash();return}
   }else{score+=25;pops.push({x:pos.x,y:H*.72,t:'+25 dodged',c:'#7bd9ff',life:1});updateHUD()}
  }}
 document.querySelectorAll('.chip').forEach((c,i)=>c.classList.toggle('danger',danger[i]));
}
