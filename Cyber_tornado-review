 else if(t<2.6){const w=Math.sin(t*7)*.35;P.la=Math.PI*.85+w;P.ra=Math.PI*.85-w;P.tilt=Math.sin(t*7)*.16;P.ll=.2+w*.3;P.rl=.2-w*.3;P.bob=Math.abs(Math.sin(t*7))*3}// overhead sway
 else if(t<3.7){const k=Math.sin(t*9);P.la=P.ra=.85;P.ll=Math.max(0,k)*1.25;P.rl=Math.max(0,-k)*1.25;P.bob=Math.abs(k)*4} // kick steps
 else if(t<4.4){P.la=P.ra=Math.PI/2;P.sx=Math.cos((t-3.7)/.7*Math.PI*2);P.bob=6} // spin
 else P.salute=true; // salute
 return P;
}
function drawDancer(x,y,s,t){
 const P=dancePose(t);
 g.save();g.translate(x,y-P.bob*s);g.scale(s*(Math.abs(P.sx)<.15?.15*Math.sign(P.sx||1):P.sx),s);g.rotate(P.tilt);
 g.lineCap='round';g.strokeStyle='#4f5a3c';g.lineWidth=10;
 arm(-5,16,-1,P.ll,30);arm(5,16,1,P.rl,30);
 if(P.salute){arm(-8,-10,-1,.05,26);g.strokeStyle='#4f5a3c';g.lineWidth=10;g.beginPath();g.moveTo(8,-10);g.lineTo(20,-18);g.lineTo(9,-35);g.stroke();g.fillStyle='#1d2618';g.beginPath();g.arc(9,-35,5,0,7);g.fill()}
 else{arm(-8,-10,-1,P.la,26);g.strokeStyle='#4f5a3c';g.lineWidth=10;arm(8,-10,1,P.ra,26)}
 g.fillStyle='#8a8463';roundRect(-12,-18,24,38,7);g.fill();g.strokeStyle='#1d2618';g.lineWidth=2;g.stroke();
 g.fillStyle='#d9b38c';g.beginPath();g.arc(0,-29,10,0,7);g.fill();
 g.fillStyle='#4b5a3a';g.beginPath();g.arc(0,-32,13,Math.PI,0);g.fill();g.fillRect(-14,-33,28,4);
 if(P.sx>0){g.fillStyle='#000';g.beginPath();g.arc(-4,-27,1.8,0,7);g.arc(4,-27,1.8,0,7);g.fill();
  g.strokeStyle='#000';g.lineWidth=1.8;g.beginPath();g.arc(0,-24,4.5,.15*Math.PI,.85*Math.PI);g.stroke()}
 g.restore();
}
function drawVictory(){
 const t=victoryT,s=Math.min(W,H)/320*1.7,feet=H*.8,cy=feet-44*s;
 const hop=clamp(t/.45,0,1),y=cy+(1-hop)*H*.35-Math.sin(hop*Math.PI)*H*.08;
 g.fillStyle='#0006';g.beginPath();g.ellipse(W*.5,feet+4,26*s,6*s,0,0,7);g.fill();
 drawDancer(W*.5,y,s,Math.max(0,t-.45));
 if(t>4.85){g.save();g.globalAlpha=clamp((t-4.85)*3,0,1);g.font='900 22px system-ui,Arial';g.textAlign='center';g.lineWidth=5;g.strokeStyle='#000b';g.strokeText('HOOAH!',W*.5,cy-64*s);g.fillStyle='#ffce86';g.fillText('HOOAH!',W*.5,cy-64*s);g.restore()}
}

/* ===== Game-over crash: windshield blows out, driver goes into the storm ===== */
function startCrash(){
 phase='crash';crashT=0;$('hud').hidden=true;cracks=[];parts=[];debris=[];flash=.4;shake=RM?0:24;
 shards=[];for(let i=0;i<80;i++){const x=rnd(W*.08,W*.92),y=rnd(H*.04,H*.8),a=Math.atan2(y-H*.5,x-W*.5),sp=rnd(140,560);
  shards.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-90,r:rnd(0,6),vr:rnd(-10,10),z:rnd(6,24),life:rnd(1,2.3)})}
 banner('EJECTED!','Out of HP','bad low');log('Out of HP: driver ejected through the windshield');
}
function limb(x1,y1,x2,y2){g.beginPath();g.moveTo(x1,y1);g.lineTo(x2,y2);g.stroke();g.fillStyle='#1d2618';g.beginPath();g.arc(x2,y2,5,0,7);g.fill()}
function drawDriver(x,y,s,rot,t){
 g.save();g.translate(x,y);g.rotate(rot);g.scale(s,s);
 const f=Math.sin(t*24),f2=Math.cos(t*19);
 g.lineCap='round';g.strokeStyle='#4f5a3c';g.lineWidth=10;
 limb(-5,16,-14+f*10,44);limb(5,16,14-f*10,44); // legs
 limb(-8,-10,-30,-30+f2*16);limb(8,-10,30,-30-f2*16); // flailing arms
 g.fillStyle='#8a8463';roundRect(-12,-18,24,38,7);g.fill();g.strokeStyle='#1d2618';g.lineWidth=2;g.stroke(); // torso
 g.fillStyle='#d9b38c';g.beginPath();g.arc(0,-29,10,0,7);g.fill(); // head
 g.fillStyle='#4b5a3a';g.beginPath();g.arc(0,-32,13,Math.PI,0);g.fill();g.fillRect(-14,-33,28,4); // helmet
 g.fillStyle='#fff';g.beginPath();g.arc(-4,-27,3.2,0,7);g.arc(4,-27,3.2,0,7);g.fill(); // big cartoon eyes
 g.fillStyle='#000';g.beginPath();g.arc(-4,-27,1.4,0,7);g.arc(4,-27,1.4,0,7);g.fill();
 g.beginPath();g.ellipse(0,-21,3,4,0,0,7);g.fill(); // "aaah" mouth
 g.restore();
}
function drawCrash(){
 const t=crashT,cx=W*.5,cy=H*.5,R=Math.max(W,H);
 const ga=clamp(1-t/1.1,0,1);
 if(ga>0){g.save();g.globalAlpha=ga;g.strokeStyle='#e8f6ff';g.lineWidth=1.8;
  for(let i=0;i<26;i++){const a=i*Math.PI/13+.1;g.beginPath();g.moveTo(cx,cy);for(let k=1;k<=5;k++){const aa=a+Math.sin(i*7+k)*.08;g.lineTo(cx+Math.cos(aa)*k*R*.14,cy+Math.sin(aa)*k*R*.14)}g.stroke()}
  for(let k=1;k<5;k++){g.beginPath();for(let i=0;i<=26;i++){const a=i*Math.PI/13+.1,r=k*R*.12*(1+Math.sin(i*3+k)*.12),x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r;i?g.lineTo(x,y):g.moveTo(x,y)}g.stroke()}
  g.restore()}
 const k=clamp(t/2.3,0,1),e=1-Math.pow(1-k,2);
 if(k<1){
  const tx=W*.5-carX*W*.1,ty=H*.42,sy=H*1.05;
  const x=cx+(tx-cx)*e+Math.sin(k*Math.PI)*W*.1;
  const y=sy+(ty-sy)*e-Math.sin(k*Math.PI)*H*.25;
  const sc=Math.max(.04,1-e*.95)*Math.min(W,H)/320*1.7;
  g.strokeStyle='#ffffff40';g.lineWidth=2;for(let i=0;i<5;i++){g.beginPath();g.moveTo(x+(i-2)*12*sc,y+40*sc);g.lineTo(x+(i-2)*16*sc,y+(90+i*8)*sc);g.stroke()}
  drawDriver(x,y,sc,t*8.5,t);
 }
 for(const s of shards){if(s.life<=0)continue;g.save();g.translate(s.x,s.y);g.rotate(s.r);g.globalAlpha=clamp(s.life,0,1)*.9;g.fillStyle='#cfeaff59';g.strokeStyle='#eaf7ff';g.lineWidth=1;g.beginPath();g.moveTo(0,-s.z);g.lineTo(s.z*.7,s.z*.5);g.lineTo(-s.z*.6,s.z*.4);g.closePath();g.fill();g.stroke();g.restore()}
}
function syncChips(){const cl=clamp(Math.round(carX),-1,1);if(cl===lastChipLane)return;lastChipLane=cl;document.querySelectorAll('.chip').forEach((c,i)=>c.classList.toggle('on',i-1===cl))}

function frame(now){
 requestAnimationFrame(frame);
 const dt=Math.min((now-last)/1000,.05);last=now;
 if(mode==='playing'&&!paused){
  elapsed+=dt;storm+=dt;
  carX+= (laneTarget-carX)*Math.min(1,dt*10);
  if(phase==='incoming'||phase==='result')updateDebris(dt);
  if(phase==='incoming'){cur.p+=dt/travelTime();if(cur.p>=1)impact()}
  else if(phase==='result'){resultT-=dt;if(resultT<=0){if(health<=0)startCrash();else nextQuestion()}}
  else if(phase==='crash'){crashT+=dt;for(const s of shards){s.x+=s.vx*dt;s.y+=s.vy*dt;s.vy+=420*dt;s.r+=s.vr*dt;s.life-=dt}if(crashT>=CRASH_LEN)finish(false)}
  else if(phase==='victory'){victoryT+=dt;if(Math.random()<dt*40){const C=['#ec4899','#a78bfa','#06b6d4','#22c55e','#eab308','#f97316','#ef4444'];parts.push({x:rnd(0,W),y:rnd(-20,H*.2),vx:rnd(-40,40),vy:rnd(0,80),life:rnd(1.6,2.6),c:C[Math.floor(Math.random()*7)]})}if(victoryT>=VICTORY_LEN)finish(true)}
  if(Math.random()<dt*.1)flash=Math.max(flash,.1);
  flash=Math.max(0,flash-dt);shake=Math.max(0,shake-dt*50);
  if(phase==='incoming')syncChips();
 }
 g.clearRect(0,0,W,H);g.save();if(shake>0)g.translate(rnd(-shake,shake),rnd(-shake*.5,shake*.5));
 drawBackground(dt);if(phase==='victory'){g.save();g.globalAlpha=clamp(1-victoryT/2,0,1);drawTornado();g.restore();drawCalm()}else drawTornado();drawDebris(false);drawSigns();drawDebris(true);drawRain(dt);drawCracks(dt);if(phase==='victory')drawVictory();drawParts(dt);drawVehicle();drawPops(dt);if(phase==='crash')drawCrash();
 if(flash>0){g.fillStyle=`rgba(225,240,255,${flash*2})`;g.fillRect(0,0,W,H)}g.restore();
}

/* ===== Controls ===== */
const canSteer=()=>mode==='playing'&&!paused&&(phase==='incoming'||phase==='result');
function moveLane(d){if(!canSteer())return;$('hint').hidden=true;laneTarget=clamp(laneTarget+d,-1,1)}
function setLane(L){if(!canSteer())return;$('hint').hidden=true;laneTarget=clamp(L,-1,1)}
function togglePause(){if(mode!=='playing')return;paused=!paused;$('pause').textContent=paused?'Resume':'Pause'}
tap($('pause'),togglePause);
tap($('restart'),()=>{if(mode==='menu')return;start()});
tap($('menuBtn'),showMenu);
document.addEventListener('keydown',e=>{const k=e.key.toLowerCase();
 if(['a','d','arrowleft','arrowright',' ','1','2','3'].includes(k)&&e.target.tagName!=='SELECT')e.preventDefault();else return;
 if(e.repeat)return;
 if(k==='a'||k==='arrowleft')moveLane(-1);else if(k==='d'||k==='arrowright')moveLane(1);
 else if(k==='1'||k==='2'||k==='3')setLane(+k-2);else if(k===' ')togglePause()});
document.addEventListener('visibilitychange',()=>{if(document.hidden&&mode==='playing'&&!paused)togglePause()});
// tap/drag on the windshield picks the lane under your finger
let dragId=null;
const laneAt=x=>clamp(Math.floor((x-canvas.getBoundingClientRect().left)/(W/3))-1,-1,1);
canvas.addEventListener('pointerdown',e=>{if(phase==='victory'&&victoryT>1.5){victoryT=VICTORY_LEN;return}if(!canSteer())return;e.preventDefault();dragId=e.pointerId;try{canvas.setPointerCapture(e.pointerId)}catch(_){}setLane(laneAt(e.clientX))});
canvas.addEventListener('pointermove',e=>{if(e.pointerId!==dragId)return;e.preventDefault();setLane(laneAt(e.clientX))});
for(const t of ['pointerup','pointercancel','lostpointercapture'])canvas.addEventListener(t,e=>{if(e.pointerId===dragId)dragId=null});
document.querySelectorAll('.chip').forEach(c=>{c.addEventListener('pointerdown',e=>{e.preventDefault();setLane(+c.dataset.lane)});c.addEventListener('keydown',e=>{if(e.key==='Enter')setLane(+c.dataset.lane)})});
for(const [id,d] of [['left',-1],['right',1]]){const b=$(id);
 b.addEventListener('pointerdown',e=>{e.preventDefault();b.classList.add('pressed');moveLane(d)});
 for(const t of ['pointerup','pointercancel','pointerleave'])b.addEventListener(t,()=>b.classList.remove('pressed'));
 b.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();moveLane(d)}})}

showMenu();requestAnimationFrame(frame);
})();
</script></body></html>
